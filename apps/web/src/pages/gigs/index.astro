---
import SiteLayout from "../../layouts/SiteLayout.astro";
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const GIGS_QUERY = `*[
  _type == "gig"
  && defined(slug.current)
]|order(date desc)[0...12]{_id, title, slug, date}`;

const gigs = await sanityClient.fetch<SanityDocument[]>(GIGS_QUERY);
---

<SiteLayout>
  <div class="container">
    <h1>Optredens</h1>

    <ul role="list">
      {
        gigs.map((gig) => (
          <li>
            <h3>{gig.title}</h3>
            <p>{gig.date}</p>
          </li>
        ))
      }
    </ul>
  </div>
</SiteLayout>
