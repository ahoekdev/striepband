---
import { PortableText } from "astro-portabletext";
import TextWithIllustration from "../components/blocks/TextWithIllustration.astro";
import GigsList from "../components/GigsList.astro";
import YouTubeEmbed from "../components/portable-text/YouTubeEmbed.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { fetchPageBySlug } from "../lib/api/pages";

interface TextWithHeadingBlock {
  _type: "textWithHeading";
  heading?: string;
  text: string;
}

// TODO generate types https://www.sanity.io/learn/course/typescripted-content
interface BlockContentBlock {
  _type: "blockContent";
  content: Array<{
    _type: string;
    [key: string]: unknown;
  }>;
}

type Block = TextWithHeadingBlock | BlockContentBlock;

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404 });
}

const page = await fetchPageBySlug(slug);

if (!page) {
  return new Response(null, { status: 404 });
}

const portableTextComponents = {
  type: {
    youTube: YouTubeEmbed,
  },
};
---

<SiteLayout>
  <div class="container">
    <h1>{page.title}</h1>

    {
      page.pageBuilder?.map((block: Block) => {
        switch (block._type) {
          case "textWithHeading":
            return <TextWithIllustration {...block} />;
          case "blockContent":
            return <PortableText value={block.content} components={portableTextComponents} />;
          default:
            return null;
        }
      })
    }

    {slug === "optredens" && <GigsList />}
  </div>
</SiteLayout>
