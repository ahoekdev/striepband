---
import type { SanityDocument } from "sanity";
import { sanityClient } from "sanity:client";

const pages = await sanityClient.fetch<SanityDocument[]>(`
  *[_type == "page"]{
    title,
    "slug": slug.current
  }
`);

const pathname = Astro.url.pathname;
---

<header>
  <div class="container">
    {pathname === "/" ? null : <a href="/">Striep</a>}

    <nav>
      <ul role="list">
        <li>
          <a href="https://www.instagram.com/striepband" target="_blank">
            <i class="ri-instagram-line"></i></a
          >
        </li>
      </ul>
      <ul role="list">
        {
          pages.map((p) => {
            const isActive = pathname === `/${p.slug}`;

            return (
              <li>
                <a href={`/${p.slug}`} class={isActive ? "active" : undefined}>
                  {p.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    height: 4rem;
    border-bottom: 1px solid black;
    background: white;

    position: sticky;
    top: 0;

    .container {
      height: 100%;
      display: flex;
      align-items: center;

      & > a {
        font-size: 1.5rem;
        font-weight: 500;
      }
    }

    nav {
      margin-left: auto;
      display: flex;
      gap: 2rem;

      ul {
        display: flex;
        gap: 1rem;
      }
    }

    a {
      text-decoration: none;
      color: black;
      position: relative;
      transition: color 0.2s;

      &:hover {
        color: var(--cl-primary-900);
      }

      &.active {
        color: var(--cl-primary-900);
        pointer-events: none;

        &::after {
          content: "";
          position: absolute;
          height: 1px;
          left: 0;
          right: 0;
          bottom: -0.125rem;
          background: currentColor;
        }
      }
    }
  }
</style>
