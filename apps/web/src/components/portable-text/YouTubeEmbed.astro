---
import ReactPlayer from "react-player";

interface Props {
  node: {
    url?: string;
  };
}

const { node } = Astro.props as Props;
---

{
  node.url ? (
    <div class="youtube-embed">
      <ReactPlayer
        client:load
        src={node.url}
        controls
        width="100%"
        height="100%"
      />
    </div>
  ) : null
}

<style>
  .youtube-embed {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: 0.25rem;
  }
</style>
